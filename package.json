{
  "name": "dsh-startup-jarvis",
  "version": "0.3.9",
  "description": "JARVIS 冷启动动画 + 操作界面皮肤 for DeepSeek Harness：30.2s 启动片、动态背景、玻璃界面、HUD 与交接转场。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-assets.mjs && node test/smoke-package.mjs",
    "pack": "npm pack --pack-destination releases"
  },
  "license": "MIT",
  "author": "沈宏宏 (QIFANAI)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIFANAI/dsh-startup-jarvis.git"
  },
  "homepage": "https://github.com/QIFANAI/dsh-startup-jarvis",
  "bugs": {
    "url": "https://github.com/QIFANAI/dsh-startup-jarvis/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "boot-animation",
    "jarvis",
    "iron-man",
    "skin",
    "glass",
    "hud",
    "video-background"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
